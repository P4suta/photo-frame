{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    "schedule:weekly",
    "customManagers:biomeVersions",
    "customManagers:dockerfileVersions",
    "customManagers:githubActionsVersions"
  ],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 6am on monday"] },
  "customDatasources": {
    "debian-trixie": {
      "format": "plain",
      "transformTemplates": [
        "($rows := releases.version.($fields := $split($, '|').$trim(); $count($fields) = 4 and $fields[0] = '{{packageName}}' and $fields[2] in ['trixie', 'trixie-updates', 'trixie-security'] ? {'version': $fields[1], 'architectures': $split($fields[3], ',').$trim()}); $available := [$distinct($rows.version).($version := $; $architectures := $distinct($rows[version = $version].architectures); 'all' in $architectures or ('amd64' in $architectures and 'arm64' in $architectures) ? {'version': $version})]; $assert($count($available) > 0, 'No Trixie package version is available for amd64 and arm64'); {'releases': [$available, $not('{{currentValue}}' in $available.version) ? {'version': '{{currentValue}}', 'isDeprecated': true}]})"
      ]
    }
  },
  "packageRules": [
    {
      "description": "Use Debian QA until the native deb datasource supports Packages.xz (renovatebot/renovate#44330).",
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["Dockerfile"],
      "matchDatasources": ["deb"],
      "matchDepTypes": ["install"],
      "overrideDatasource": "custom.debian-trixie",
      "versioning": "deb",
      "registryUrls": ["https://qa.debian.org/madison.php?package={{packageName}}&text=on"],
      "groupName": "debian packages"
    },
    {
      "matchManagers": ["cargo"],
      "groupName": "rust crates"
    },
    {
      "description": "Performance-critical crates land in their own group so a bump that changes bench numbers gets a discrete PR — easier to bisect a regression to the right `BENCHMARKS.md` row.",
      "matchManagers": ["cargo"],
      "matchPackageNames": [
        "divan",
        "iai-callgrind",
        "zune-jpeg",
        "zune-core",
        "fast_image_resize",
        "jpeg-encoder",
        "dhat",
        "tracing-flame",
        "wasm-bindgen-rayon"
      ],
      "groupName": "perf crates"
    },
    {
      "description": "Keep Mise and Docker pins for matching performance tools together.",
      "matchPackageNames": [
        "cargo:samply",
        "samply",
        "cargo:inferno",
        "inferno",
        "cargo:iai-callgrind-runner",
        "iai-callgrind-runner",
        "hyperfine"
      ],
      "groupName": "perf crates"
    },
    {
      "description": "Keep the host and container Taplo pins together.",
      "matchPackageNames": ["taplo", "taplo-cli"],
      "groupName": "taplo"
    },
    {
      "matchManagers": ["npm"],
      "groupName": "npm packages"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "pinDigests": true
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchDatasources": ["docker"],
      "groupName": "docker base images"
    },
    {
      "description": "Project policy: track latest. Minor + patch bumps auto-merge once CI is green; only majors gate on human review.",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "lockFileMaintenance"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "matchUpdateTypes": ["major"],
      "addLabels": ["major-bump"],
      "automerge": false
    },
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["biome"],
      "overrideDatasource": "npm",
      "overridePackageName": "@biomejs/biome"
    },
    {
      "matchFileNames": ["mise.toml", "Dockerfile", ".github/workflows/ci.yml", "biome.json"],
      "matchDepNames": ["biome", "@biomejs/biome"],
      "groupName": "biome",
      "minimumGroupSize": 4
    },
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["aqua:rustwasm/wasm-pack"],
      "overrideDatasource": "crate",
      "overridePackageName": "wasm-pack"
    },
    {
      "matchDepNames": ["bun"],
      "groupName": "bun",
      "minimumGroupSize": 3
    },
    {
      "matchDepNames": ["wasm-pack", "aqua:rustwasm/wasm-pack"],
      "groupName": "wasm-pack",
      "minimumGroupSize": 3
    }
  ]
}
